# The image only needs requirements.txt, src/, templates/ and static/. Everything else stays out of the build context.

# VCS, environments, caches
.git
.gitignore
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache

# Secrets: settings come from env_file at runtime
.env
.env.*

# Local data / state (the SQLite file lives on a volume)
data
**/*.db
**/*.db-wal
**/*.db-shm
logs
**/*.log
.qdrant_storage
_archive
_trash

# Not needed to run the app
tests
docs
notebooks
playground
plan.md
