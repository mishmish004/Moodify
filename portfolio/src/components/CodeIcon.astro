---
// The </> mark that stands in for GitHub everywhere on the site.
interface Props { size?: number }
const { size = 20 } = Astro.props;
---

<svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7l-5 5 5 5"></path><path d="M16 7l5 5-5 5"></path></svg>
