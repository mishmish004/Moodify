---
// Where everyone lands until they sign in. src/worker.ts sends signed-out visitors here and lets
// only this page, its styles and fonts through; the button starts Google sign-in at /auth/google.
import Base from '../layouts/Base.astro';
import { SESSION_DAYS } from '../lib/auth';

export const prerender = false;

// ?error= values set by src/lib/auth.ts
const ERRORS: Record<string, string> = {
  cancelled: 'Sign-in was cancelled. Pick an account to come in.',
  expired: 'That sign-in took too long, or started in another tab. Try again.',
  failed: 'Google didn’t confirm the sign-in. Try again in a minute.',
  unavailable: 'Sign-in isn’t working right now. Try again later.',
};

const params = Astro.url.searchParams;
const errorKey = params.get('error') ?? '';
const error = Object.hasOwn(ERRORS, errorKey) ? ERRORS[errorKey] : undefined;
const signedOut = params.has('signed-out');
const next = params.get('next');
const signInHref = next ? `/auth/google?next=${encodeURIComponent(next)}` : '/auth/google';

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base title="Sign in — amish" description="Sign in with Google to see mish4mish.com." noindex>
  <main id="main" class="gate" tabindex="-1">
    <span class="logo">amish</span>

    <section class="panel box rise" aria-labelledby="signin-h">
      <p class="label">mish4mish.com · sign in</p>
      <h1 id="signin-h" class="display">Sign in to look around.</h1>
      <p class="lede muted">Anyone with a Google account can come in. Sign in once and this device stays signed in for {SESSION_DAYS} days.</p>

      {error && (
        <div class="alert" role="alert">
          <svg aria-hidden="true" width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="#B42318" stroke-width="1.8" stroke-linecap="round"><circle cx="10" cy="10" r="8"></circle><path d="M10 5.5v5.5M10 13.8v.3"></path></svg>
          <span>{error}</span>
        </div>
      )}
      {signedOut && !error && <p class="note" role="status">You’re signed out.</p>}

      <a class="btn btn-line google" href={signInHref}>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"></path><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"></path><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"></path><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"></path></svg>
        Continue with Google
      </a>

      <p class="fine muted">Google tells this site your account ID and email address. They’re kept only in a cookie on this device, and signing out deletes it.</p>
    </section>
  </main>
</Base>

<style>
  .gate {
    min-height: 100vh; min-height: 100svh; padding: 16px var(--gutter) 40px;
    display: flex; flex-direction: column; align-items: center; gap: clamp(32px, 8vh, 96px);
  }
  .gate:focus { outline: none; }
  .logo {
    align-self: flex-start; display: flex; align-items: center; min-height: 52px; padding: 0 18px;
    border: 1px solid var(--line); border-radius: 10px; background: var(--surface);
    font-family: var(--display); font-weight: 600; font-size: 21px;
  }
  .box { width: 100%; max-width: 520px; display: flex; flex-direction: column; align-items: flex-start; gap: 18px; }
  h1 { font-size: clamp(36px, 5vw, 56px); line-height: 0.98; letter-spacing: -0.02em; }
  .lede { font-size: 17px; line-height: 1.5; }
  .alert { width: 100%; }
  .alert svg { flex: 0 0 20px; margin-top: 1px; }
  .note { padding: 12px 16px; border-radius: 10px; background: var(--wash); font-size: 15px; }
  .google { width: 100%; min-height: 52px; gap: 12px; font-size: 17px; font-weight: 500; border-radius: 10px; }
  .google svg { flex: 0 0 20px; }
  .fine { font-size: 14px; line-height: 1.5; }
</style>
