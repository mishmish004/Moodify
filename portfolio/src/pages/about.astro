---
import Site from '../layouts/Site.astro';
import { hindiNumber } from '../lib/content';
import { about } from '../site/pages';
import { site } from '../site/site';

const hasHindi = about.shortHi.length > 0;
const links = [
  { label: 'GitHub', handle: site.github.handle, href: site.github.url, external: true },
  { label: 'LinkedIn', handle: site.linkedin.handle, href: site.linkedin.url, external: true },
  { label: 'Email', handle: site.email, href: '/contact', external: false },
  { label: 'The incident log', handle: 'yapping', href: '/yapping', external: false },
  { label: 'What I’m doing now', handle: '/now', href: '/now', external: false },
];
---

<Site title="About — amish" description={`${about.headline} ${about.subline}`} current="about">
  <section class="hero pad" aria-labelledby="about-h">
    <div class="hero-text">
      <p class="label rise">about</p>
      <h1 id="about-h" class="display rise d1"><span>{about.headline}</span><span class="muted">{about.subline}</span></h1>
    </div>
    {about.portrait && (
      <div class="portrait rise d2"><img src={about.portrait.src} alt={about.portrait.alt} width="380" height="475" decoding="async" /></div>
    )}
  </section>

  {about.shortEn.length > 0 && (
    <section class="short pad rule" aria-labelledby="short-h" data-lang-scope data-lang="en">
      <div class="short-side">
        <h2 id="short-h" class="label">the short version</h2>
        {hasHindi && <button class="lang-pill" type="button" data-lang-toggle aria-pressed="false">hindi mai</button>}
      </div>
      <div class="swap-grid short-text">
        <div lang="en">{about.shortEn.map((p) => <p>{p}</p>)}</div>
        {hasHindi && <div lang="hi" aria-hidden="true">{about.shortHi.map((p) => <p>{p}</p>)}</div>}
      </div>
    </section>
  )}

  <section class="facts-wrap pad" aria-labelledby="facts-h">
    <h2 id="facts-h" class="sr-only">Quick facts</h2>
    <dl class="facts">
      {about.facts.map((f) => <div><dt class="label">{f.k}</dt><dd class="display">{f.v}</dd></div>)}
    </dl>
  </section>

  <section class="how pad rule" aria-labelledby="how-h">
    <h2 id="how-h" class="display">how I work</h2>
    <ol class="principles">
      {about.principles.map((p, i) => (
        <li>
          <span lang="hi" aria-hidden="true" class="deva-num">{hindiNumber(i + 1)}</span>
          <div><h3 class="display">{p.t}</h3><p>{p.d}</p></div>
        </li>
      ))}
    </ol>
  </section>

  <section class="else pad" aria-labelledby="else-h">
    <h2 id="else-h" class="label">elsewhere</h2>
    <ul class="rows else-list">
      {links.map((l) => (
        <li>
          <a class="row-link" href={l.href}>
            <span class="row-title display">{l.label}</span>
            <span class="mono handle">{l.handle} <span class:list={['arrow', { 'arrow-up': l.external }]} aria-hidden="true">{l.external ? '↗' : '→'}</span></span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="cta pad">
    <p class="display">Want the formal version?</p>
    <div class="cta-btns">
      <a class="btn btn-line" href="/resume">Read the résumé <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn-dark" href="/contact">Say hello</a>
    </div>
  </section>
</Site>

<style>
  .pad { padding-left: var(--gutter); padding-right: var(--gutter); }
  .rule { border-top: 1px solid var(--line); }
  .hero {
    padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(56px, 7vw, 96px);
    display: flex; flex-wrap: wrap; align-items: flex-end; gap: 40px clamp(32px, 5vw, 80px);
  }
  .hero-text { flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px; }
  h1 { font-size: clamp(44px, 6.4vw, 96px); line-height: 0.92; letter-spacing: -0.025em; }
  h1 span { display: block; }
  .portrait { flex: 1 1 280px; max-width: 380px; min-width: 0; }
  .portrait img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; border-radius: 10px; background: var(--tile); }

  .short { padding-top: clamp(56px, 7vw, 96px); padding-bottom: clamp(56px, 7vw, 96px); display: flex; flex-wrap: wrap; gap: 24px clamp(32px, 5vw, 80px); }
  .short-side { flex: 1 1 240px; display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .short-text { flex: 999 1 560px; min-width: 0; max-width: 820px; font-size: clamp(19px, 1.6vw, 22px); line-height: 1.55; color: var(--ink-2); }
  .short-text > div { display: flex; flex-direction: column; gap: 20px; }
  .short-text [lang='hi'] { font-size: clamp(20px, 1.7vw, 23px); line-height: 1.75; }

  .facts-wrap { padding-bottom: clamp(56px, 7vw, 96px); }
  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); border-top: 1px solid var(--line); }
  .facts > div { padding: 24px 24px 24px 0; border-bottom: 1px solid var(--line); display: flex; flex-direction: column; gap: 6px; }
  .facts dd { font-size: clamp(22px, 2vw, 28px); line-height: 1.15; letter-spacing: -0.01em; }

  .how { padding-top: clamp(56px, 7vw, 96px); padding-bottom: clamp(56px, 7vw, 96px); }
  .how h2 { margin-bottom: 32px; font-size: clamp(40px, 4.8vw, 72px); line-height: 1; letter-spacing: -0.02em; }
  .principles { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--line); }
  .principles li { display: flex; flex-wrap: wrap; gap: 12px 40px; padding: 32px 0; border-top: 1px solid var(--line); }
  .principles .deva-num { flex: 0 0 56px; font-size: 32px; padding-top: 2px; }
  .principles div { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
  .principles h3 { font-size: clamp(26px, 2.6vw, 36px); line-height: 1.1; letter-spacing: -0.015em; }
  .principles p { color: var(--muted); font-size: 17px; line-height: 1.55; }

  .else { padding-top: clamp(56px, 7vw, 96px); display: flex; flex-wrap: wrap; gap: 32px clamp(32px, 5vw, 80px); }
  .else h2 { flex: 1 1 240px; }
  .else-list { flex: 999 1 560px; min-width: 0; }
  .else-list .row-link { flex-wrap: wrap; align-items: baseline; padding: 20px 0; }
  .else-list .row-title { font-size: clamp(24px, 2.2vw, 30px); line-height: 1.1; letter-spacing: -0.01em; }
  .handle { display: inline-flex; align-items: baseline; gap: 10px; font-size: 13px; color: var(--muted); }

  .cta { padding-top: clamp(72px, 8vw, 120px); padding-bottom: 40px; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .cta p { font-size: clamp(36px, 4.4vw, 64px); line-height: 0.98; letter-spacing: -0.02em; max-width: 820px; }
  .cta-btns { display: flex; flex-wrap: wrap; gap: 12px; }
</style>

<script>
  import { initLangToggles } from '../scripts/lang';
  initLangToggles();
</script>
