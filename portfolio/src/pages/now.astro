---
import Site from '../layouts/Site.astro';
import { now } from '../site/pages';
---

<Site title="Now — amish" description="What Amish is focused on right now.">
  <section class="hero pad" aria-labelledby="n-h">
    <p class="meta rise"><span class="chip"><span class="dot" aria-hidden="true"></span>now</span>updated {now.updated} · from {now.from}</p>
    <h1 id="n-h" class="display rise d1">What I'm doing now.</h1>
    <p class="lede rise d2">A snapshot of where my attention goes these days. If you're reading this months from now, it's probably out of date. <a href="/contact">Nudge me</a>.</p>
  </section>

  <dl class="rows-dl pad">
    {now.rows.map((r) => (
      <div class="row">
        <dt class="label">{r.k}</dt>
        <dd>
          <p class="display v">{r.v}</p>
          {r.note && <p class="muted note">{r.note}</p>}
          {r.href && <a href={r.href}>{r.link ?? r.href} <span class="arrow arrow-up" aria-hidden="true">&#160;↗</span></a>}
        </dd>
      </div>
    ))}
  </dl>

  <p class="about pad muted">This is a now page. The idea comes from <a href="https://nownownow.com/about">nownownow.com</a>: one page that says what you're focused on, instead of everything you've ever done.</p>
</Site>

<style>
  .pad { padding-left: var(--gutter); padding-right: var(--gutter); }
  .hero { padding-top: clamp(32px, 5vw, 72px); padding-bottom: clamp(40px, 5vw, 64px); display: flex; flex-direction: column; gap: 24px; max-width: 1000px; }
  .meta { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; font-family: var(--mono); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
  h1 { font-size: clamp(44px, 6.4vw, 96px); line-height: 0.92; letter-spacing: -0.025em; }
  .lede { max-width: 620px; font-size: clamp(18px, 1.6vw, 21px); line-height: 1.5; color: var(--muted); }

  .rows-dl { border-bottom: 1px solid var(--line); }
  .row { display: flex; flex-wrap: wrap; gap: 8px 40px; padding: 32px 0; border-top: 1px solid var(--line); }
  .row dt { flex: 0 0 200px; padding-top: 8px; }
  .row dd { flex: 1 1 520px; min-width: 0; max-width: 820px; display: flex; flex-direction: column; gap: 10px; }
  .v { font-size: clamp(24px, 2.4vw, 34px); line-height: 1.15; letter-spacing: -0.015em; }
  .note { font-size: 16px; line-height: 1.55; }
  .row a { align-self: flex-start; display: inline-flex; align-items: center; min-height: 44px; font-size: 15px; }
  .about { padding-top: 32px; font-size: 15px; line-height: 1.55; max-width: 760px; }
</style>
