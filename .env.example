# Copy to .env and fill in. Required: SECRET_KEY, SPOTIFY_CLIENT_ID, OPENAI_API_KEY.

# dev | test | prod
ENV=dev

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# From https://developer.spotify.com/dashboard (Settings of your app)
SPOTIFY_CLIENT_ID=your-spotify-client-id
# Not used by the PKCE login flow; leave commented unless something needs it
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must match a Redirect URI in the Spotify dashboard exactly. 127.0.0.1, not localhost; HTTPS in prod
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9091/callback

# YouTube Music (Phase 27). From https://console.cloud.google.com/apis/credentials: an OAuth client of type
# "Web application" in a project with the YouTube Data API v3 enabled. Leave unset to offer only Spotify
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match an authorized redirect URI of that client exactly; HTTPS in prod
# GOOGLE_REDIRECT_URI=http://127.0.0.1:9091/callback/youtube
# The project's daily YouTube Data API quota in units (Google's default is 10,000)
# YOUTUBE_DAILY_QUOTA=10000

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
# Reads each prompt into a brief before songs are picked; defaults to OPENAI_MODEL
# OPENAI_BRIEF_MODEL=gpt-5.4-mini
# Optional: judges how library tracks sound, in the background (Phase 22). Unset: OPENAI_MODEL
# OPENAI_FEATURES_MODEL=gpt-5.4-mini
# Optional: recalls lessons by meaning (Phase 31). Empty: by their tags alone
# OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Defaults to <project>/data/moodify.db (/app/data/moodify.db in Docker)
# DB_PATH=data/moodify.db
BASE_URL=http://127.0.0.1:9091
# Shown on /privacy as the address for privacy questions; unset, it says to ask whoever sent the link
# CONTACT_EMAIL=you@example.com
