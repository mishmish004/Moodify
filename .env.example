# Copy to .env and fill in. Required: SECRET_KEY, SPOTIFY_CLIENT_ID, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, OPENAI_API_KEY.

# dev | test | prod
ENV=dev

# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me

# From https://developer.spotify.com/dashboard (Settings of your app)
SPOTIFY_CLIENT_ID=your-spotify-client-id
# Not used by the PKCE login flow; leave commented unless something needs it
# SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Must match a Redirect URI in the Spotify dashboard exactly. 127.0.0.1, not localhost; HTTPS in prod
SPOTIFY_REDIRECT_URI=http://127.0.0.1:9091/callback

# Google sign-in, asked before the Spotify login; any Google account gets in.
# Google Cloud console > Google Auth Platform > Clients > a "Web application" client
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must be an Authorized redirect URI of that client. Defaults to /signin/callback on
# SPOTIFY_REDIRECT_URI's host (http://127.0.0.1:9091/signin/callback locally)
# GOOGLE_REDIRECT_URI=https://moodify.example.com/signin/callback

OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.4-mini
# Reads each prompt into a brief before songs are picked; defaults to OPENAI_MODEL
# OPENAI_BRIEF_MODEL=gpt-5.4-mini

# Defaults to <project>/data/moodify.db (/app/data/moodify.db in Docker)
# DB_PATH=data/moodify.db
BASE_URL=http://127.0.0.1:9091
